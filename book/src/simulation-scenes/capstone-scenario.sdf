<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="capstone_world">
    <!-- Include the outdoor environment -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    
    <include>
      <uri>model://sun</uri>
    </include>
    
    <!-- Add a simple house-like structure for the capstone scenario -->
    <!-- Living room area -->
    <model name="living_room_wall_1">
      <pose>0 5 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>10 0.2 2.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>10 0.2 2.5</size>
            </box>
          </geometry>
        </collision>
        <pose>0 0 1.25 0 0 0</pose>
      </link>
    </model>
    
    <model name="living_room_wall_2">
      <pose>-5 0 0 0 0 1.5707</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>6 0.2 2.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>6 0.2 2.5</size>
            </box>
          </geometry>
        </collision>
        <pose>0 0 1.25 0 0 0</pose>
      </link>
    </model>
    
    <!-- Kitchen area -->
    <model name="kitchen_wall_1">
      <pose>5 2.5 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>4 0.2 2.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.9 1</ambient>
            <diffuse>0.7 0.7 0.9 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>4 0.2 2.5</size>
            </box>
          </geometry>
        </collision>
        <pose>0 0 1.25 0 0 0</pose>
      </link>
    </model>
    
    <model name="kitchen_wall_2">
      <pose>3 5 0 0 0 1.5707</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>5 0.2 2.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.9 1</ambient>
            <diffuse>0.7 0.7 0.9 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>5 0.2 2.5</size>
            </box>
          </geometry>
        </collision>
        <pose>0 0 1.25 0 0 0</pose>
      </link>
    </model>
    
    <!-- Bedroom area -->
    <model name="bedroom_wall_1">
      <pose>-2 -5 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>6 0.2 2.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.7 0.7 1</ambient>
            <diffuse>0.9 0.7 0.7 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>6 0.2 2.5</size>
            </box>
          </geometry>
        </collision>
        <pose>0 0 1.25 0 0 0</pose>
      </link>
    </model>
    
    <!-- Add furniture to make the environment more realistic -->
    <!-- Living room furniture -->
    <model name="sofa">
      <pose>-2 3 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>2 1 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>2 1 0.8</size>
            </box>
          </geometry>
        </collision>
        <pose>0 0 0.4 0 0 0</pose>
      </link>
    </model>
    
    <model name="coffee_table">
      <pose>0 2 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 0.6 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.6 0.4 1</ambient>
            <diffuse>0.8 0.6 0.4 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 0.6 0.5</size>
            </box>
          </geometry>
        </collision>
        <pose>0 0 0.25 0 0 0</pose>
      </link>
    </model>
    
    <!-- Kitchen furniture -->
    <model name="kitchen_table">
      <pose>4 1 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>1.5 1.5 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>1.5 1.5 0.8</size>
            </box>
          </geometry>
        </collision>
        <pose>0 0 0.4 0 0 0</pose>
      </link>
    </model>
    
    <!-- Bedroom furniture -->
    <model name="bed">
      <pose>-2 -4 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>2.2 1.8 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 1.0 1</ambient>
            <diffuse>0.8 0.8 1.0 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>2.2 1.8 0.5</size>
            </box>
          </geometry>
        </collision>
        <pose>0 0 0.25 0 0 0</pose>
      </link>
    </model>
    
    <!-- Add objects for the humanoid to interact with -->
    <!-- Objects in living room -->
    <model name="red_cup">
      <pose>-0.5 2.2 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.1</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.1</length>
            </cylinder>
          </geometry>
        </collision>
        <pose>0 0 0.05 0 0 0</pose>
      </link>
    </model>
    
    <model name="book">
      <pose>0.3 2.3 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 0.15 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.8 1</ambient>
            <diffuse>0.2 0.2 0.8 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 0.15 0.02</size>
            </box>
          </geometry>
        </collision>
        <pose>0 0 0.01 0 0 0</pose>
      </link>
    </model>
    
    <!-- Objects in kitchen -->
    <model name="ball">
      <pose>4.2 1.2 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.07</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.1 0.8 0.1 1</ambient>
            <diffuse>0.1 0.8 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.07</radius>
            </sphere>
          </geometry>
        </collision>
        <pose>0 0 0.07 0 0 0</pose>
      </link>
    </model>
    
    <!-- Add a simple humanoid robot model -->
    <model name="simple_humanoid">
      <pose>0 0 1 0 0 0</pose>
      <link name="base_link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>0.8</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>0.8</length>
            </cylinder>
          </geometry>
        </collision>
        <inertial>
          <mass>10.0</mass>
          <inertia>
            <ixx>0.4</ixx>
            <iyy>0.4</iyy>
            <izz>0.2</izz>
          </inertia>
        </inertial>
      </link>
      
      <!-- Head -->
      <link name="head_link">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.1</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.1</radius>
            </sphere>
          </geometry>
        </collision>
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.0067</ixx>
            <iyy>0.0067</iyy>
            <izz>0.0067</izz>
          </inertia>
        </inertial>
      </link>
      <joint name="neck_joint" type="revolute">
        <parent>base_link</parent>
        <child>head_link</child>
        <axis>
          <xyz>0 0 1</xyz>
        </axis>
        <pose relative_to="base_link">0 0 0.5 0 0 0</pose>
      </joint>
      
      <!-- Arms -->
      <link name="left_arm_link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.6</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.6</length>
            </cylinder>
          </geometry>
        </collision>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.015</ixx>
            <iyy>0.015</iyy>
            <izz>0.00125</izz>
          </inertia>
        </inertial>
      </link>
      <joint name="left_shoulder_joint" type="revolute">
        <parent>base_link</parent>
        <child>left_arm_link</child>
        <axis>
          <xyz>0 1 0</xyz>
        </axis>
        <pose relative_to="base_link">0.2 0 0.2 0 0 0</pose>
      </joint>
      
      <link name="right_arm_link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.6</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.6</length>
            </cylinder>
          </geometry>
        </collision>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.015</ixx>
            <iyy>0.015</iyy>
            <izz>0.00125</izz>
          </inertia>
        </inertial>
      </link>
      <joint name="right_shoulder_joint" type="revolute">
        <parent>base_link</parent>
        <child>right_arm_link</child>
        <axis>
          <xyz>0 1 0</xyz>
        </axis>
        <pose relative_to="base_link">-0.2 0 0.2 0 0 0</pose>
      </joint>
      
      <!-- Define the robot as a manipulator for Gazebo -->
      <static>false</static>
    </model>
    
    <!-- Define coordinate frames for navigation -->
    <frame name="map_frame" attached_to="world">
      <pose>0 0 0 0 0 0</pose>
    </frame>
    
    <frame name="kitchen_frame" attached_to="kitchen_table">
      <pose>0 0 1.2 0 0 0</pose>
    </frame>
    
    <frame name="living_room_frame" attached_to="coffee_table">
      <pose>0 0 1.0 0 0 0</pose>
    </frame>
    
    <frame name="bedroom_frame" attached_to="bed">
      <pose>0 0 1.0 0 0 0</pose>
    </frame>
    
    <!-- Add lighting -->
    <light name="ambient_light" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>20</range>
      </attenuation>
      <direction>-0.3 -0.3 -1</direction>
    </light>
    
    <!-- Add sensors for perception -->
    <model name="rgbd_camera">
      <pose>0 0 1.5 0 0 0</pose>
      <link name="link">
        <sensor name="rgbd_camera" type="rgbd_camera">
          <pose>0.1 0 0 0 0 0</pose>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>10</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
        </sensor>
      </link>
    </model>
    
    <!-- Add a simple plane for the ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>